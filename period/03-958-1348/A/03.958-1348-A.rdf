    <bib:Book rdf:about="urn:isbn:978-2-503-52360-6">
        <z:itemType>book</z:itemType>
        <dcterms:isPartOf>
            <bib:Series>
                <dc:title>Studies in European Urban History</dc:title>
                <dc:identifier>19</dc:identifier>
            </bib:Series>
        </dcterms:isPartOf>
        <dc:publisher>
